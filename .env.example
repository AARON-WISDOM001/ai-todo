# Local environment. Copy to `.env.local` and fill in.
#
# `.env.local` is gitignored. Never commit a real key — the AI endpoints read
# this variable on the server only, and it must never reach the browser bundle.

# Required for any AI feature to work. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Optional alias, accepted if GEMINI_API_KEY is unset. `GOOGLE_API_KEY` is the
# name the Google Cloud console uses, so it is convenient when provisioning
# through Terraform or the gcloud CLI.
# GOOGLE_API_KEY=
